<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>fvenc</AssemblyName>
    <RootNamespace>Gericom.FastVideoDSEncoder</RootNamespace>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <!--
    FastVideoDS encoder for mobipeg. This is Gericom's proven FastVideoDS codec
    (github.com/Gericom/FastVideoDSEncoder), with the x86 AVX2 fast-paths replaced
    by their bit-identical scalar equivalents so it builds and runs on arm64
    (Rosetta 2 has no AVX2). The FFmpeg.AutoGen native decoder is dropped: this
    reads raw BGRA video frames + interleaved s16 stereo PCM produced by mobipeg's
    bundled ffmpeg, and writes a .fv container identical to the reference muxer.
  -->
</Project>
